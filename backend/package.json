{
  "name": "canai-build",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "tsc --project tsconfig.json",
    "build:prod": "tsc --project tsconfig.prod.json",
    "build:js": "node scripts/build-js.js",
    "build:deploy": "node scripts/build-deploy.js",
    "start": "node dist/start.js",
    "start:dev": "node start.js",
    "lint": "turbo run lint",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/ --coverage",
    "test:integration": "vitest run tests/integration/ --coverage",
    "test:deployment": "vitest run tests/integration/ --coverage && vitest run backend/health.js",
    "typecheck": "tsc --noEmit",
    "migrate:test": "npx supabase db migrate --env test",
    "test:supabase:connection": "vitest run tests/integration/supabase/*.test.ts tests/integration/supabase/*.integration.test.ts",
    "check:supabase:connection": "node scripts/check-supabase.js",
    "test:ci": "vitest run --reporter=dot --reporter=junit --outputFile=./test-results.xml --silent",
    "backend": "npm run build && node dist/start.js",
    "start:prod": "node dist/start.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.0.0",
    "@commitlint/config-conventional": "^18.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/body-parser": "^1.19.2",
    "@types/convict": "^6.1.1",
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/express-list-endpoints": "^6.0.0",
    "@types/express-unless": "^0.5.2",
    "@types/express-validator": "^3.0.0",
    "@types/helmet": "^4.0.0",
    "@types/http-graceful-shutdown": "^2.3.0",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^24.0.4",
    "@types/p-retry": "^3.0.1",
    "@types/pino-http": "^5.8.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/serialize-error": "^4.0.1",
    "@types/tsc-watch": "^4.2.0",
    "@types/validator": "^13.7.1",
    "@types/wait-on": "^5.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
