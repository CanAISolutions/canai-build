# Run commitlint as a final check (redundant, but ensures config is always enforced)
echo "Running commitlint check..."
npx --no -- commitlint --edit "$1"
COMMITLINT_STATUS=$?
if [ $COMMITLINT_STATUS -ne 0 ]; then
  echo "Commit message failed commitlint validation. See error above."
  exit 1
fi
echo "Commit message validation passed."