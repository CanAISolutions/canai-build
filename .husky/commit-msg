#!/usr/bin/env sh

# Run the custom validator (compiled from TypeScript)
node .scripts/validate-commit-msg.cjs "$1"
VALIDATOR_STATUS=$?
if [ $VALIDATOR_STATUS -ne 0 ]; then
  echo "Commit message failed custom validation. See error above."
  exit 1
fi

# Run commitlint as a final check (redundant, but ensures config is always enforced)
npx --no -- commitlint --edit "$1"
